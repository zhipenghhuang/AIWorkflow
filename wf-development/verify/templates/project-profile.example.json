{
  "_comment": "复制为项目根 .gate/project-profile.json；勿写入wf-development/verify/。缺项时尝试 package.json；仍缺则 SKIP/BLOCKED。定向：仅当 *_scoped 含 {files} 时注入本任务变更路径，检查 id=targeted-*；否则跑下方全仓命令，id=project-*。",
  "build": "npm run build",
  "lint": "npm run lint",
  "test": "npm test",
  "lint_scoped": "",
  "test_scoped": "",
  "e2e_scoped": "",
  "_scoped_examples": {
    "lint_scoped": "npx eslint {files}",
    "test_scoped": "npx vitest related {files} --run",
    "e2e_scoped": "npx playwright test {files}"
  },
  "e2e": "npx playwright test",
  "smoke": "npm run test:smoke",
  "integration": "npm run test:integration",
  "security": "",
  "frontend": {
    "baseUrl": "http://localhost:3000",
    "viewports": ["360x800", "768x1024", "1280x800"],
    "pages": ["/"],
    "evidenceDir": ".gate/frontend",
    "capture": "python scripts/frontend_capture.py --config capture.json",
    "requireScreenshots": true,
    "requireGeneratedEvidence": true,
    "requireParity": true,
    "requireParityMatrix": true,
    "routeCoverage": "route-coverage.json",
    "prototype": "inbound/V0.4/原型.html",
    "prototypeManifest": ".gate/prototype/prototype.json",
    "designQaItems": 20,
    "requireStates": ["loading", "empty", "error", "permission"],
    "requireConsoleClean": true,
    "requireNetworkCheck": true,
    "requireA11y": false,
    "_capture_note": "requireGeneratedEvidence=true（L2+ 默认）：门先跑 capture，再校验 evidence.json 与截图哈希；手写证据不算。capture 参考 verify/frontend/capture_example.py"
  },
  "timeouts": {
    "build": 600,
    "lint": 300,
    "test": 600,
    "e2e": 900,
    "capture": 900,
    "integration": 900,
    "security": 900
  }
}
